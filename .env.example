# Пример переменных окружения VuzFinder (VPS).
# Скопировать в .env и заполнить реальными значениями. .env в git не попадает.

APP_ENV=production

# Имя существующей Docker-сети Nginx Proxy Manager на VPS.
# Уточнить перед деплоем: docker network ls
PROXY_NETWORK_NAME=npm_default

# --- Домены ---
FRONTEND_URL=https://vuzfinder.ru
API_URL=https://api.vuzfinder.ru
# Build-time для frontend (Vite): базовый URL API.
VITE_API_URL=https://api.vuzfinder.ru

# --- PostgreSQL ---
POSTGRES_DB=university
POSTGRES_USER=university
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://university:change_me@postgres:5432/university
MIGRATION_DATABASE_URL=postgresql://university:change_me@postgres:5432/university

# --- CORS (prod: только публичные домены фронта, через запятую) ---
CORS_ORIGINS=https://vuzfinder.ru,https://www.vuzfinder.ru

# --- Парсер ---
PARSER_TRIGGER_TOKEN=change_me
PARSER_STALE_HOURS=24
PARSER_STUCK_MINUTES=180
PARSER_RECORDS_DROP_PERCENT=50
SNAPSHOT_RETENTION_DAYS=60
PARSER_CONCURRENCY=1
# APScheduler внутри API — только для локальной разработки.
ENABLE_SCHEDULER=false

# --- Telegram-алерты ---
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Бэкапы ---
BACKUP_RETENTION_DAYS=14
