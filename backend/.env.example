# Пример настроек. Скопируйте в файл .env и подставьте свои значения.

# Подключение к PostgreSQL (асинхронный драйвер asyncpg).
# Формат: postgresql+asyncpg://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БД
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5544/univer_parser

# Запускать браузер без окна (true на сервере, false для отладки).
HEADLESS=true

# Таймаут загрузки страницы в миллисекундах.
BROWSER_TIMEOUT_MS=30000

# --- Очередь и мониторинг (см. DEPLOY_PLAN.md) ---

# APScheduler внутри API — только для локальной разработки (в проде systemd).
ENABLE_SCHEDULER=false

# Пауза между опросами очереди воркером (python -m app.cli consume-queue), сек.
QUEUE_POLL_SECONDS=15

# Порог свежести данных (часов) для check-parser-health / health-API.
PARSER_STALE_HOURS=24

# running-задача старше N минут считается зависшей (recover-stuck-runs).
PARSER_STUCK_MINUTES=180

# Хранить снимки парсинга N дней (cleanup-snapshots).
SNAPSHOT_RETENTION_DAYS=60
